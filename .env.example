# Copie para .env e ajuste o que precisar (usado por `docker compose`).
# Nada aqui é obrigatório para rodar localmente com `npm run dev`.

# Porta publicada no host pelo docker compose (a aplicação escuta 8787 dentro do container).
APP_PORT=8787

# 1 = mantém a conta demo do login (bom para demonstração).
# 0 = desativa a conta demo e esconde o botão "Entrar como demo" (use em produção com alunos).
SEED_DEMO=0

# auto  = cookie Secure quando a requisição chega por HTTPS (padrão)
# always = força Secure (exige HTTPS)
# never = só para depuração local
COOKIE_SECURE=auto

# Saltos de proxy confiáveis (Caddy, nginx, Render, Fly, Cloudflare). 0 desliga.
TRUST_PROXY=1

# Segredo de sessão/cifragem. Se vazio, é gerado em DATA_DIR/app.secret.
# Em produção, defina: openssl rand -hex 32
APP_SECRET=

# E-mail de contato enviado à API do OpenAlex (boa prática).
OPENALEX_MAILTO=
