{
  "name": "study-flux",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Study Flux — do material de estudo ao caso clínico: plataforma de treino por casos para estudantes de medicina.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed/run.ts",
    "typecheck": "tsc --noEmit",
    "reset": "node scripts/reset.mjs",
    "test:discovery": "tsx scripts/test-discovery.ts",
    "test:discovery:live": "tsx scripts/test-discovery-live.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.9",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
