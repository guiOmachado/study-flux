{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "web-ng",
  "projects": {
    "study-flux": {
      "projectType": "application",
      "root": "web-ng",
      "sourceRoot": "web-ng/src",
      "prefix": "sf",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "web/dist",
              "browser": ""
            },
            "index": "web-ng/src/index.html",
            "browser": "web-ng/src/main.ts",
            "polyfills": [],
            "tsConfig": "web-ng/tsconfig.app.json",
            "assets": [],
            "styles": [
              "web-ng/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "900kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kB",
                  "maximumError": "40kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "none",
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "study-flux:build:production"
            },
            "development": {
              "buildTarget": "study-flux:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "buildTarget": "study-flux:build:development",
            "host": "0.0.0.0",
            "port": 5173,
            "proxyConfig": "web-ng/proxy.conf.json"
          }
        }
      }
    }
  }
}
